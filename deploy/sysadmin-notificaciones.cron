# Notificaciones y emails de SysAdmin.
#
# - generar_notificaciones_mantenimiento: una vez al día por la mañana.
# - enviar_notificaciones_email: cada 5 minutos para vaciar la cola.
#
# Corre como root porque `docker exec` lo necesita.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# Generar notificaciones de mantenimiento a las 08:05
5 8 * * * root docker exec sysadmin_django python manage.py generar_notificaciones_mantenimiento >>/var/log/sysadmin-notificaciones.log 2>&1

# Enviar emails de la cola cada 5 minutos
*/5 * * * * root docker exec sysadmin_django python manage.py enviar_notificaciones_email >>/var/log/sysadmin-emails.log 2>&1
