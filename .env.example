# ─────────────────────────────────────────────────────────────────────────────
# SysAdmin · Variables de entorno
# Copiar este archivo a .env y completar los valores antes de levantar.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ───────────────────────────────────────────────────────────────────
# Clave secreta de Django. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambiar_esto_por_una_clave_secreta_larga

# Clave Fernet para el vault de contraseñas. Debe tener 44 caracteres.
# Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si ya hay secretos guardados con la clave anterior (derivada de SECRET_KEY),
# siguen legibles; tras definirla, re-cifrarlos una vez con:
#   docker exec sysadmin_django python manage.py rotar_clave_vault
PASSWORDS_ENCRYPTION_KEY=

# Entorno
DEBUG=False
DJANGO_SETTINGS_MODULE=sysadmin.settings.production
ALLOWED_HOSTS=192.168.1.250,localhost,127.0.0.1

# ── Base de datos PostgreSQL ─────────────────────────────────────────────────
POSTGRES_DB=sysadmin_db
POSTGRES_USER=sysadmin_user
POSTGRES_PASSWORD=cambiar_esta_contraseña
DB_HOST=db
DB_PORT=5432

# ── Seguridad HTTPS (producción detrás de nginx) ─────────────────────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
TRUSTED_ORIGINS=https://192.168.1.250:6060

# ── OCS Inventory / Yule ─────────────────────────────────────────────────────
# La configuración en BD (/yule/configuracion/) tiene prioridad sobre estas.
OCS_BASE_URL=http://192.168.1.250:8081/ocsapi/v1
OCS_USER=Administrador
OCS_TOKEN=cambiar_esto_por_el_token_de_ocs
OCS_VERIFY_SSL=False

# ── SMTP (opcional, para envío de emails) ────────────────────────────────────
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_USUARIO=usuario@ejemplo.com
# SMTP_PASSWORD=contraseña
# SMTP_USA_TLS=True
# SMTP_USA_SSL=False

# ── Cooldown formulario público de tickets (segundos) ────────────────────────
SOPORTE_REPORTE_PUBLICO_COOLDOWN_SEGUNDOS=60

# ── Timeout de sesión por inactividad (segundos) ─────────────────────────────
# Recomendado: 900-1800 (15-30 min). Default 180 s (3 min) si no se define.
SESSION_COOKIE_AGE=180

# ── URL base para códigos QR ─────────────────────────────────────────────────
# Si los QR generan URLs sin puerto o apuntan a una URL interna diferente,
# definir aquí la URL pública completa (sin barra final).
QR_BASE_URL=https://192.168.1.250:6060

# ── Gunicorn (producción) ────────────────────────────────────────────────────
# Número de workers y tiempo máximo por petición (segundos).
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=120
